<UserControl x:Class="TrackSync.Controls.NotificationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Пустое состояние -->
        <StackPanel x:Name="EmptyState" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Grid.Row="1"
                        Visibility="Visible">
            <TextBlock Style="{StaticResource TitleText}" 
                           FontSize="16" 
                           Foreground="#7F8C8D"
                           Text="Нет уведомлений"/>
            <TextBlock Style="{StaticResource BodyText}"
                           Foreground="#95A5A6"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="10,5,10,0"
                           Text="Приглашения в походы и заявки от пользователей будут отображаться здесь"/>
        </StackPanel>

        <!-- Список уведомлений БЕЗ внутреннего ScrollViewer -->
        <ItemsControl x:Name="NotificationsList"
                          Grid.Row="1"
                          Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HikeItemStyle}" 
                                Margin="0,0,0,12"
                                Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <!-- Цветная полоса: синяя для приглашений, оранжевая для заявок -->
                            <Border Width="6" 
                                        Grid.Column="0" 
                                        Margin="0,0,15,0" 
                                        CornerRadius="3,0,0,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#3498DB"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NotificationType}" Value="Bid">
                                                <Setter Property="Background" Value="#F39C12"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Контент уведомления -->
                            <StackPanel Grid.Column="1">
                                <!-- Заголовок уведомления -->
                                <TextBlock FontWeight="Bold"
                                        Foreground="#2C3E50"
                                        TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                            <Setter Property="Text" Value="Приглашение в поход"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotificationType}" Value="Bid">
                                                    <Setter Property="Text" Value="Заявка в поход"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Основной контент -->
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" 
                                                   Style="{StaticResource BodyText}"
                                                   Foreground="#2C3E50"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding DateRange}" 
                                                   Style="{StaticResource BodyText}"
                                                   Foreground="#7F8C8D"
                                                   FontSize="13"
                                                   Margin="0,2,0,0"/>

                                    <!-- Для заявок: отображаем email пользователя -->
                                    <TextBlock Text="{Binding Email}" 
                                                   Style="{StaticResource BodyText}"
                                                   Foreground="#E74C3C"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding EmailVisibility}"/>

                                    <!-- Описание похода (только для приглашений) -->
                                    <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource BodyText}"
                                                   Foreground="#95A5A6"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="40"
                                                   Visibility="{Binding DescriptionVisibility}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Кнопки действий -->
                            <StackPanel Grid.Column="2" 
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                <Button Content="Принять"
                                            Style="{StaticResource TextButton}"
                                            MaxWidth="75"
                                            Padding="8,4"
                                            Margin="0,0,8,0"
                                            Tag="{Binding Id}"
                                            Click="AcceptButton_Click"/>

                                <Button Content="Отклонить"
                                            Style="{StaticResource TextButton}"
                                            MaxWidth="75"
                                            Padding="8,4"
                                            Tag="{Binding Id}"
                                            Click="RejectButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>