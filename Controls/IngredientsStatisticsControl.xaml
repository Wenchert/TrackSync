<UserControl x:Class="TrackSync.Controls.IngredientsStatisticsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrackSync.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Style="{StaticResource TitleText}" FontSize="24" 
   Text="Статистика ингредиентов" Margin="0,0,0,10"/>
            <TextBlock Style="{StaticResource BodyText}" FontSize="14" Foreground="#7F8C8D"
   Text="Общая стоимость продуктовой раскладки по всем дням похода"/>
        </StackPanel>

        <!-- Основной контент с прокруткой -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Общая сводка по стоимости -->
                <Border Style="{StaticResource WidgetStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
               Text="Общая финансовая сводка" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                       Foreground="#7F8C8D" Text="Общая стоимость"/>
                                <TextBlock x:Name="TotalCostText" Style="{StaticResource TitleText}" 
                       FontSize="20" Text="0 руб." Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                       Foreground="#7F8C8D" Text="На одного участника"/>
                                <TextBlock x:Name="CostPerPersonText" Style="{StaticResource TitleText}" 
                       FontSize="20" Text="0 руб." Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8F9FA" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="#7F8C8D"
                   TextWrapping="Wrap">
                        <Run Text="Расчет основан на количестве участников: "/>
                        <Run x:Name="ParticipantsCountRun" Text="0"/>
                        <Run Text=" человек"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Детализация по ингредиентам -->
                <Border Style="{StaticResource WidgetStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
               Text="Детализация по ингредиентам" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" FontSize="13"
                   Foreground="#7F8C8D" Text="Ингредиент"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" FontSize="13"
                   Foreground="#7F8C8D" Text="Общая стоимость"/>
                        </Grid>

                        <Separator Margin="0,5,0,10" Background="#BDC3C7"/>

                        <!-- Список ингредиентов -->
                        <ItemsControl x:Name="IngredientsStatisticsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" 
                        Padding="0,8,0,8" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource BodyText}" 
                                       Text="{Binding IngredientTitle}" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                           Foreground="#7F8C8D" Text="Общий вес: "/>
                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                           Text="{Binding TotalWeight,  StringFormat={}{0} грамм}"/>
                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                           Foreground="#7F8C8D" Text=" • Используется в: " Margin="8,0,0,0"/>
                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                           Text="{Binding UsedInRecipesCount, StringFormat={}{0} рецепт(ов)}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource BodyText}" 
                                       Text="{Binding TotalCost, StringFormat={}{0} руб.}" 
                                       FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                       Foreground="#7F8C8D" Text="{Binding CostPerPerson, StringFormat={}{0} руб./чел}"
                                       HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Сообщение, если нет данных -->
                        <TextBlock x:Name="NoIngredientsText" Style="{StaticResource BodyText}" 
                       Text="Нет данных для отображения. Добавьте рецепты в раскладку."
                       Foreground="#7F8C8D" HorizontalAlignment="Center"
                       Margin="0,20,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
