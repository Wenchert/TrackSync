<Page x:Class="TrackSync.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrackSync.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="TrackSync"
      Background="White">
    <Page.CommandBindings>
        <CommandBinding Command="{x:Static local:AuthorizationPage.Login}" Executed="CommandBindingExecuted"/>
    </Page.CommandBindings>
    <Page.InputBindings>
        <KeyBinding Key="Return" Command="{x:Static local:AuthorizationPage.Login}"/>
    </Page.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="32" 
                                   FontWeight="Bold" Text="Track" 
                                   Foreground="#3498DB"/>
                        <TextBlock Style="{StaticResource TitleText}" FontSize="32" 
                                   FontWeight="Bold" Text="Sync" 
                                   Foreground="#1B4F72"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="Планирование туристических походов" 
                               Foreground="#7F8C8D" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,20">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
                                   Foreground="#3498DB" MouseDown="OnLoginMouseDown" 
                                   x:Name="LoginTitle" Text="Вход" Cursor="Hand"/>
                        <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
                                   Text=" / " Margin="8,0,8,0" Foreground="#BDC3C7"/>
                        <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
                                   Foreground="#95A5A6" MouseDown="OnRegisterMouseDown" 
                                   x:Name="RegisterTitle" Text="Регистрация" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel x:Name="LoginPanel" Margin="0,0,0,15">
                        <TextBlock Style="{StaticResource BodyText}" Text="Логин" 
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource InputField}" x:Name="LoginText" 
                                 MaxLength="256"/>
                    </StackPanel>

                    <StackPanel x:Name="PasswordPanel" Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" Text="Пароль" 
                                   Margin="0,0,0,5"/>
                        <PasswordBox Style="{StaticResource PasswordField}" x:Name="PasswordText" 
                                    MaxLength="256"/>
                    </StackPanel>
                    <StackPanel x:Name="HeightWeightPanel" Visibility="Collapsed" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BodyText}" Text="Рост (см)" 
                                           Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="1" x:Name="HeightText" 
                                             Style="{StaticResource InputField}" 
                                             TextAlignment="Center" Text="170"
                                             PreviewTextInput="NumberPreviewTextInput"
                                             MaxLength="3"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource BodyText}" Text="Вес (кг)" 
                                           Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="1" x:Name="WeightText" 
                                             Style="{StaticResource InputField}" 
                                             TextAlignment="Center" Text="70"
                                             PreviewTextInput="NumberPreviewTextInput"
                                             MaxLength="3"/>

                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodyText}" 
                               Foreground="#E74C3C" TextWrapping="Wrap" 
                               Visibility="Collapsed" Margin="0,0,0,15"/>
                    <Button x:Name="AuthButton" Style="{StaticResource MainButton}" 
                            Content="Войти" Command="{x:Static local:AuthorizationPage.Login}"
                            Background="#3498DB" Margin="0,0,0,15">
                        <Button.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="10" 
                                            Opacity="0.1" Color="#3498DB"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center" 
                               Foreground="#BDC3C7" Text="© 2026 TrackSync. Все права защищены."/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="1" Background="#34495E">
            <Grid>
                <Rectangle>
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="../Images/background.jpg" Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Border Background="#80000000" Padding="30">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="24" 
                                   Foreground="White" Text="Откройте мир приключений"
                                   Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="16" 
                                   Foreground="#ECF0F1" TextWrapping="Wrap"
                                   Text="Планируйте маршруты, распределяйте снаряжение и создавайте незабываемые походы вместе с TrackSync"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid x:Name="IpBlockPanel" Visibility="Collapsed" Grid.ColumnSpan="2">
            <Border Background="#34495E" Opacity="0.95" CornerRadius="8" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Ваш IP-адрес временно заблокирован" 
                       FontSize="18" Style="{StaticResource TitleText}" Foreground="#ECF0F1"/>
                    <TextBlock Text="Слишком много неудачных попыток входа" 
                       FontSize="14" Foreground="#BDC3C7"
                       Style="{StaticResource BodyText}"/>
                    <TextBlock x:Name="TimerText" Text="15:00" FontSize="28" 
                       Foreground="#3498DB" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Повторите попытку через указанное время" 
                       FontSize="14" Foreground="#ECF0F1"
                       Style="{StaticResource TitleText}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>