<Page x:Class="TrackSync.Pages.CreateIngredientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Создание ингредиента"
      Background="#F8F9FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,30,40,30">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center">

            <StackPanel Margin="0,0,0,30">
                <TextBlock Style="{StaticResource TitleText}" FontSize="28" 
                           FontWeight="Bold" Text="Создание ингредиента"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="16"
                           Text="Добавьте новый ингредиент в каталог для использования в рецептах"
                           Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource WidgetStyle}">
                <StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Название ингредиента" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="TitleTextBox"
                                 MaxLength="256"
                                 Height="40"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Пример: Рис, Куриная грудка, Макароны"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Калорийность на 100г (ккал)" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="CaloriesTextBox"
                                 Height="40"
                                 PreviewTextInput="NumberPreviewTextInput"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Укажите количество калорий на 100 грамм продукта"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Пищевая ценность на 100г" 
                                   Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Text="Белки (г)" 
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource InputField}" 
                                         x:Name="ProteinsTextBox"
                                         Height="40"
                                         PreviewTextInput="NumberPreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Text="Жиры (г)" 
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource InputField}" 
                                         x:Name="FatsTextBox"
                                         Height="40"
                                         PreviewTextInput="NumberPreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Text="Углеводы (г)" 
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource InputField}" 
                                         x:Name="CarbsTextBox"
                                         Height="40"
                                         PreviewTextInput="NumberPreviewTextInput"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Цена (руб.)" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="PriceTextBox"
                                 Height="40"
                                 PreviewTextInput="NumberPreviewTextInput"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Укажите цену за 100 грамм продукта"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Рекомендованный вес на человека" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="RecommendedWeightTextBox"
                                 MaxLength="40"
                                 Height="40"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Пример: 100-150 г/чел (необязательное поле)"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodyText}" 
                               Foreground="#E74C3C" TextWrapping="Wrap" 
                               Visibility="Collapsed" Margin="0,0,0,15"
                               FontSize="14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TextButton}" 
                                x:Name="CancelButton"
                                Click="CancelButton_Click"
                                Margin="0,0,15,0">
                            <TextBlock Text="Отмена"/>
                        </Button>
                        <Button Style="{StaticResource MainButton}" 
                                x:Name="CreateButton"
                                Click="CreateButton_Click"
                                Padding="28,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Создать ингредиент"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>