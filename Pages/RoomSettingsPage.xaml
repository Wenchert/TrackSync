<Page x:Class="TrackSync.Pages.RoomSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="TrackSync - Настройки комнаты"
      Background="#F8F9FA">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,30,40,30">
        <StackPanel MaxWidth="700" HorizontalAlignment="Center">

            <StackPanel Margin="0,0,0,30">
                <TextBlock Style="{StaticResource TitleText}" FontSize="28" 
                           FontWeight="Bold" Text="Настройки комнаты"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="16"
                           Text="Управляйте параметрами вашей комнаты и правами участников"
                           Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource WidgetStyle}">
                <StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Название комнаты" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="TitleTextBox"
                                 MaxLength="256"
                                 Height="40"
                                 TextChanged="TitleTextBox_TextChanged"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Название похода"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Тип комнаты" 
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="PublicRoomRadio" Content="Публичная" 
                                        FontSize="14" Foreground="#2C3E50"
                                        Checked="RoomTypeRadio_Checked"
                                        Margin="0,0,20,0"/>
                            <RadioButton x:Name="PrivateRoomRadio" Content="Приватная" 
                                        FontSize="14" Foreground="#2C3E50"
                                        Checked="RoomTypeRadio_Checked"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap"
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Text="Публичная - любой пользователь может найти и присоединиться. Приватная - только по приглашению или паролю."/>
                    </StackPanel>

                    <StackPanel x:Name="PasswordPanel" Margin="0,0,0,20" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Пароль для входа" 
                                   Margin="0,0,0,8"/>
                        <PasswordBox Style="{StaticResource PasswordField}" 
                                     x:Name="PasswordBox"
                                     Height="40"
                                     MaxLength="256"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Пароль необходим для присоединения к приватной комнате (минимум 8 символов)"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Описание похода" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="DescriptionTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"
                                 MaxHeight="300"
                                 TextChanged="DescriptionTextBox_TextChanged"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Напишите дополнительную информацию о походе"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Даты похода" 
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Text="Начало похода" 
                                           Margin="0,0,0,5"
                                           FontSize="13"/>
                                <DatePicker x:Name="StartDatePicker" 
                                           Style="{StaticResource DatePickerStyle}"
                                           SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Text="Окончание похода" 
                                           Margin="0,0,0,5"
                                           FontSize="13"/>
                                <DatePicker x:Name="EndDatePicker" 
                                           Style="{StaticResource DatePickerStyle}"
                                           SelectedDateChanged="EndDatePicker_SelectedDateChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Text="Укажите период проведения похода"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Статус похода" 
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="StatusComboBox" 
                                  Style="{StaticResource ComboBoxStyle}"
                                  Height="40"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Текущее состояние похода"/>
                    </StackPanel>

                    <Border Height="1" Background="#E9ECEF" Margin="0,20,0,20"/>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="20" 
                                   FontWeight="SemiBold" Text="Права доступа участников"
                                   Margin="0,0,0,15"/>

                        <TextBlock Style="{StaticResource BodyText}" 
                                   Text="Установите права для каждого участника комнаты"
                                   Foreground="#7F8C8D" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <StackPanel x:Name="ParticipantsPermissionsPanel" Margin="0,0,0,25">
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ParticipantsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RoomItemStyle}" Margin="0,0,0,15">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Шапка участника -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Style="{StaticResource TitleText}" FontSize="16" 
                                                               FontWeight="SemiBold" 
                                                               Text="{Binding UserName}"/>
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                                               Foreground="#7F8C8D" 
                                                               Margin="0,3,0,0"
                                                               Text="{Binding Email}"/>
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                               Foreground="#95A5A6" 
                                                               Margin="0,3,0,0"
                                                               Text="{Binding Role}"/>
                                                            <TextBlock FontSize="12"
                                                               Foreground="#3498DB" 
                                                               Margin="0,3,0,0"
                                                               Text="{Binding Contacts}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="40"
                                                               TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                                        <Setter Property="FontSize" Value="12"/>
                                                                        <Setter Property="Foreground" Value="#3498DB"/>
                                                                        <Setter Property="Margin" Value="0,3,0,0"/>
                                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                                        <Setter Property="MaxHeight" Value="40"/>
                                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value="Контакты не указаны">
                                                                                <Setter Property="Foreground" Value="#95A5A6"/>
                                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <!-- Кнопка исключения (только для не-лидеров) -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                            <Button x:Name="ExcludeButton"
                                                                Tag="{Binding ParticipantId}"
                                                                Click="ExcludeButton_Click"
                                                                ToolTip="Исключить пользователя из комнаты"
                                                                Style="{StaticResource IconButton}"
                                                                Visibility="{Binding CanExclude, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Width="25" Height="25"
                                                                Margin="5,0,0,0">
                                                                <Image Source="/Images/Icons/trash.png" Width="25" Height="25"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Права доступа -->
                                                    <StackPanel Grid.Row="1" Margin="0,15,0,0">
                                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" 
                                                            Text="Права доступа:" Margin="0,0,0,10"/>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" 
                                                                VerticalAlignment="Center">
                                                                <CheckBox IsChecked="{Binding EditMealPlan, Mode=TwoWay}" 
                                                                    IsEnabled="{Binding IsEditable}"
                                                                    Margin="0,0,15,0"/>
                                                                <TextBlock Style="{StaticResource BodyText}" Text="Редактировать план питания"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                                                VerticalAlignment="Center">
                                                                <CheckBox IsChecked="{Binding EditTrack, Mode=TwoWay}" 
                                                                      IsEnabled="{Binding IsEditable}"
                                                                      Margin="0,0,15,0"/>
                                                                <TextBlock Style="{StaticResource BodyText}" Text="Редактировать маршрут"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,8,0,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <CheckBox IsChecked="{Binding EditEquipment, Mode=TwoWay}" 
                                                                    IsEnabled="{Binding IsEditable}"
                                                                    Margin="0,0,15,0"/>
                                                                <TextBlock Style="{StaticResource BodyText}" Text="Редактировать снаряжение"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="NoParticipantsMessage" 
                               Style="{StaticResource BodyText}"
                               Foreground="#7F8C8D"
                               Text="В этой комнате пока нет участников"
                               Visibility="Collapsed"
                               Margin="0,15,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodyText}" 
                               Foreground="#E74C3C" TextWrapping="Wrap" 
                               Visibility="Collapsed" Margin="0,0,0,15"
                               FontSize="14"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TextButton}" 
                                x:Name="CancelButton"
                                Click="CancelButton_Click"
                                Margin="0,0,15,0">
                            <TextBlock Text="Отмена"/>
                        </Button>
                        <Button Style="{StaticResource MainButton}" 
                                x:Name="SaveButton"
                                Click="SaveButton_Click"
                                Padding="28,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Сохранить изменения"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>