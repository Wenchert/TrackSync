<Page x:Class="TrackSync.Pages.ProfileSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Настройки профиля"
      Background="#F8F9FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,30,40,30">
        <StackPanel MaxWidth="700" HorizontalAlignment="Center">
            <StackPanel Margin="0,0,0,30">
                <TextBlock Style="{StaticResource TitleText}" FontSize="28" 
                           FontWeight="Bold" Text="Настройки профиля"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="16"
                           Text="Управляйте вашими персональными данными и настройками безопасности"
                           Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource WidgetStyle}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="20" 
                                   FontWeight="SemiBold" Text="Безопасность "
                                   Margin="0,0,0,15"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Text="Для изменения пароля мы отправим инструкции на вашу электронную почту"
                                   Foreground="#7F8C8D" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>
                        <Button Style="{StaticResource MainButton}" 
                                x:Name="ChangePasswordButton"
                                Click="ChangePasswordButton_Click"
                                Background="#3498DB"
                                Height="45"
                                Padding="20,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Изменить пароль через почту" 
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="PasswordChangeMessage" Style="{StaticResource BodyText}" 
                                   Foreground="#28A745" TextWrapping="Wrap" 
                                   Visibility="Collapsed" Margin="0,10,0,0"
                                   FontSize="13">
                            <Run Text="✓ "/>
                            <Run Text="Инструкции для смены пароля отправлены на вашу почту. Проверьте папку 'Входящие' или 'Спам'."/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="20" 
                                   FontWeight="SemiBold" Text="Физические параметры"
                                   Margin="0,0,0,15"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Text="Укажите ваши текущие параметры для корректного распределения снаряжения"
                                   Foreground="#7F8C8D" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           FontWeight="SemiBold" 
                                           Text="Рост (см)" 
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="HeightDecreaseBtn" Grid.Column="0" 
                                            Content="-" Width="36" Height="36" 
                                            Click="HeightDecreaseBtn_Click"
                                            Style="{StaticResource NumberButton}"/>
                                    <TextBox Grid.Column="1" x:Name="HeightText" 
                                             Style="{StaticResource InputField}" 
                                             TextAlignment="Center" 
                                             PreviewTextInput="NumberPreviewTextInput"
                                             MaxLength="3"
                                             Height="36"/>
                                    <Button x:Name="HeightIncreaseBtn" Grid.Column="2" 
                                            Content="+" Width="36" Height="36"
                                            Click="HeightIncreaseBtn_Click"
                                            Style="{StaticResource NumberButton}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Foreground="#7F8C8D" 
                                           FontSize="12"
                                           Margin="0,5,0,0"
                                           Text="Минимум: 40 см"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           FontWeight="SemiBold" 
                                           Text="Вес (кг)" 
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="WeightDecreaseBtn" Grid.Column="0" 
                                            Content="-" Width="36" Height="36"
                                            Click="WeightDecreaseBtn_Click"
                                            Style="{StaticResource NumberButton}"/>
                                    <TextBox Grid.Column="1" x:Name="WeightText" 
                                             Style="{StaticResource InputField}" 
                                             TextAlignment="Center" 
                                             PreviewTextInput="NumberPreviewTextInput"
                                             MaxLength="3"
                                             Height="36"/>
                                    <Button x:Name="WeightIncreaseBtn" Grid.Column="2" 
                                            Content="+" Width="36" Height="36"
                                            Click="WeightIncreaseBtn_Click"
                                            Style="{StaticResource NumberButton}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Foreground="#7F8C8D" 
                                           FontSize="12"
                                           Margin="0,5,0,0"
                                           Text="Минимум: 20 кг"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="20" 
                                   FontWeight="SemiBold" Text="Описание профиля"
                                   Margin="0,0,0,15"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="О себе" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="ProfileDescriptionTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"
                                 MaxHeight="300"
                                 TextChanged="ProfileDescriptionTextBox_TextChanged"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Расскажите о себе, своих предпочтениях в походах и опыте"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodyText}" 
                               Foreground="#E74C3C" TextWrapping="Wrap" 
                               Visibility="Collapsed" Margin="0,0,0,15"
                               FontSize="14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TextButton}" 
                                x:Name="CancelButton"
                                Click="CancelButton_Click"
                                Margin="0,0,15,0">
                            <TextBlock Text="Отмена"/>
                        </Button>
                        <Button Style="{StaticResource MainButton}" 
                                x:Name="SaveButton"
                                Click="SaveButton_Click"
                                Padding="28,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Сохранить изменения"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>