<Page x:Class="TrackSync.Pages.ProfileSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Настройки профиля"
      Background="#F8F9FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,30,40,30">
        <StackPanel MinWidth="300" MaxWidth="500" HorizontalAlignment="Stretch">
            <!-- Заголовок страницы -->
            <StackPanel Margin="0,0,0,30">
                <TextBlock Style="{StaticResource TitleText}" FontSize="28" 
               FontWeight="Bold" Text="Настройки профиля"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="16"
               Text="Управляйте вашими персональными данными и настройками безопасности"
               Foreground="#7F8C8D" Margin="0,5,0,0"/>

                <!-- Кнопка выхода -->
                <Button Style="{StaticResource TextButton}" 
                    x:Name="LogoutButton"
                    Click="LogoutButton_Click"
                    HorizontalAlignment="Left"
                    Margin="0,15,0,0"
                    Foreground="#E74C3C">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Выйти из аккаунта"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ВКЛАДКИ НАСТРОЕК -->
            <Border Style="{StaticResource WidgetStyle}">
                <TabControl Padding="20" HorizontalAlignment="Stretch">
                    <!-- Вкладка 1: Профиль -->
                    <!-- Вкладка 1: Профиль -->
                    <TabItem Header="Профиль">
                        <StackPanel Margin="0,10,0,0">
                            <!-- Email (только для чтения) -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Style="{StaticResource BodyText}" 
                       FontWeight="SemiBold" 
                       Text="Электронная почта" 
                       Margin="0,0,0,8"/>
                                <TextBox x:Name="EmailTextBox" 
                     Style="{StaticResource InputField}" 
                     IsReadOnly="True"
                     Height="40"
                     Background="#F0F0F0"
                     Foreground="#555"/>
                                <TextBlock Style="{StaticResource BodyText}" 
                       Foreground="#7F8C8D" 
                       FontSize="12"
                       Margin="0,5,0,0"
                       Text="Ваша почта используется для входа в систему"/>
                            </StackPanel>

                            <!-- Имя пользователя -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Имя" 
                                   Margin="0,0,0,8"/>
                                <TextBox x:Name="NameTextBox" 
                                    Style="{StaticResource InputField}" 
                                    Height="40"
                                    MaxLength="30"/>
                                <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Ваше имя будет отображаться в приложении"/>
                            </StackPanel>

                            <!-- Контакты -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Контактная информация" 
                                   Margin="0,0,0,8"/>
                                <TextBox x:Name="ContactsTextBox" 
                                     Style="{StaticResource InputField}" 
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="80"
                                     MaxHeight="150"/>
                                <TextBlock Style="{StaticResource BodyText}" 
                                       Foreground="#7F8C8D" 
                                       FontSize="12"
                                       Margin="0,5,0,0"
                                       Text="Телефон, соцсети или другие способы связи"/>
                            </StackPanel>

                            <!-- Физические параметры -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
                                           FontWeight="SemiBold" Text="Физические параметры"
                                           Margin="0,0,0,15"/>
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Text="Укажите ваши текущие параметры для корректного распределения снаряжения"
                                           Foreground="#7F8C8D" 
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,15"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Рост -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource BodyText}" 
                                                   FontWeight="SemiBold" 
                                                   Text="Рост (см)" 
                                                   Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="1" x:Name="HeightText" 
                                                     Style="{StaticResource InputField}" 
                                                     TextAlignment="Center" 
                                                     PreviewTextInput="NumberPreviewTextInput"
                                                     MaxLength="3"
                                                     Height="36"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource BodyText}" 
                                                   Foreground="#7F8C8D" 
                                                   FontSize="12"
                                                   Margin="0,5,0,0"
                                                   Text="Минимум: 40 см"/>
                                    </StackPanel>

                                    <!-- Вес -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource BodyText}" 
                                                   FontWeight="SemiBold" 
                                                   Text="Вес (кг)" 
                                                   Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="1" x:Name="WeightText" 
                                                     Style="{StaticResource InputField}" 
                                                     TextAlignment="Center" 
                                                     PreviewTextInput="NumberPreviewTextInput"
                                                     MaxLength="3"
                                                     Height="36"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource BodyText}" 
                                                   Foreground="#7F8C8D" 
                                                   FontSize="12"
                                                   Margin="0,5,0,0"
                                                   Text="Минимум: 20 кг"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Сообщение об ошибке -->
                            <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodyText}" 
                                       Foreground="#E74C3C" TextWrapping="Wrap" 
                                       Visibility="Collapsed" Margin="0,0,0,15"
                                       FontSize="14"/>

                            <!-- Кнопки действий -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TextButton}" 
                                        x:Name="CancelButton"
                                        Click="CancelButton_Click"
                                        Margin="0,0,15,0">
                                    <TextBlock Text="Отмена"/>
                                </Button>
                                <Button Style="{StaticResource MainButton}" 
                                        x:Name="SaveProfileButton"
                                        Click="SaveProfileButton_Click"
                                        Padding="28,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Сохранить изменения"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- Вкладка 2: Безопасность -->
                    <TabItem Header="Безопасность" HorizontalAlignment="Stretch">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
                                       FontWeight="SemiBold" Text="Изменение пароля"
                                       Margin="0,0,0,15"/>

                            <TextBlock Style="{StaticResource BodyText}" 
                                       Text="Для защиты вашего аккаунта, пожалуйста, введите новый пароль"
                                       Foreground="#7F8C8D" 
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,25"/>

                            <!-- Текущий пароль -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           FontWeight="SemiBold" 
                                           Text="Текущий пароль" 
                                           Margin="0,0,0,8"/>
                                <PasswordBox x:Name="CurrentPasswordBox" 
                                             Style="{StaticResource PasswordField}" 
                                             Height="40"/>
                            </StackPanel>

                            <!-- Новый пароль -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           FontWeight="SemiBold" 
                                           Text="Новый пароль" 
                                           Margin="0,0,0,8"/>
                                <PasswordBox x:Name="NewPasswordBox" 
                                             Style="{StaticResource PasswordField}" 
                                             Height="40"/>
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Foreground="#7F8C8D" 
                                           FontSize="12"
                                           Margin="0,5,0,0"
                                           Text="Минимум 8 символов"/>
                            </StackPanel>

                            <!-- Подтверждение пароля -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           FontWeight="SemiBold" 
                                           Text="Подтверждение пароля" 
                                           Margin="0,0,0,8"/>
                                <PasswordBox x:Name="ConfirmPasswordBox" 
                                             Style="{StaticResource PasswordField}" 
                                             Height="40"/>
                            </StackPanel>

                            <!-- Сообщение об успехе/ошибке -->
                            <TextBlock x:Name="PasswordMessage" Style="{StaticResource BodyText}" 
                                       Foreground="#E74C3C" TextWrapping="Wrap" 
                                       Visibility="Collapsed" Margin="0,0,0,20"
                                       FontSize="14"/>

                            <!-- Кнопки действий -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TextButton}" 
                                        x:Name="CancelPasswordButton"
                                        Click="CancelButton_Click"
                                        Margin="0,0,15,0">
                                    <TextBlock Text="Отмена"/>
                                </Button>
                                <Button Style="{StaticResource MainButton}" 
                                        x:Name="ChangePasswordButton"
                                        Click="ChangePasswordButton_Click"
                                        Padding="28,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Изменить пароль"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>