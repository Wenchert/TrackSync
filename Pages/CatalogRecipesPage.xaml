<Page x:Class="TrackSync.Pages.CatalogRecipesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Каталог рецептов"
      Background="#F8F9FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,30,40,30">
        <StackPanel>

            <StackPanel Margin="0,0,0,30">
                <TextBlock Style="{StaticResource TitleText}" FontSize="28" 
                           FontWeight="Bold" Text="Каталог рецептов"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="16"
                           Text="Выберите рецепт для добавления в продуктовую раскладку"
                           Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource WidgetStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            Background="White"
                            BorderBrush="#E9ECEF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" 
                                   Source="/Images/Icons/search.png" 
                                   Width="18" Height="18" 
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" 
                                     x:Name="SearchTextBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="8,0,12,0"
                                     FontSize="14"
                                     Foreground="#2C3E50"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" 
                            Style="{StaticResource MainButton}"
                            Click="CreateRecipeButton_Click"
                            Margin="15,0,0,0"
                            Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+ Создать рецепт"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border Style="{StaticResource WidgetStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold"
                                       Text="Название рецепта"
                                       Margin="15,10,10,10"/>

                            <TextBlock Grid.Column="1" 
                                       Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold"
                                       Text="Вес"
                                       Margin="10,10,10,10"/>

                            <TextBlock Grid.Column="2" 
                                       Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold"
                                       Text="Калории"
                                       Margin="10,10,15,10"/>
                        </Grid>

                        <Border Height="2" 
                                Background="#3498DB"
                                Margin="0,5,0,15"/>
                        <ItemsControl x:Name="RecipesListBox">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RecipeBorder"
                                            Style="{StaticResource HikeItemStyle}" 
                                            Margin="0,0,0,8"
                                            Height="50"
                                            MouseLeftButtonDown="RecipeItem_MouseLeftButtonDown"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Style="{StaticResource BodyText}" 
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Recipe.Title}"
                                                       Margin="15,0,10,0"/>

                                            <TextBlock Grid.Column="1" 
                                                       Style="{StaticResource BodyText}" 
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Weight, StringFormat={}{0}г}"
                                                       Foreground="#7F8C8D"
                                                       Margin="10,0,10,0"/>

                                            <TextBlock Grid.Column="2" 
                                                       Style="{StaticResource BodyText}" 
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Calories, StringFormat={}{0} ккал}"
                                                       Foreground="#7F8C8D"
                                                       Margin="10,0,15,0"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="RecipeBorder" Property="Style" Value="{StaticResource SelectedEquipmentItemStyle}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Style="{StaticResource TextButton}" 
                        x:Name="CancelButton"
                        Click="CancelButton_Click"
                        Padding="24,12">
                    <TextBlock Text="Отмена"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>