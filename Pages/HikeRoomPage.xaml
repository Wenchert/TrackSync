<Page x:Class="TrackSync.Pages.HikeRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Комната похода"
      Background="#F8F9FA">

    <Page.Resources>
        <DataTemplate x:Key="RecipeTemplate">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Recipe.Title}"/>
                </StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                               Foreground="#7F8C8D" Text="Вес на человека"/>
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding WeightPerPersonText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                               Foreground="#7F8C8D" Text="Время готовки"/>
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding CookTimeText}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,0,0,5">
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Text="Ингредиенты:"/>
                    <ItemsControl ItemsSource="{Binding Ingredients}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" Margin="15,3,0,0"
                                       Text="{Binding Text}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                        Foreground="#7F8C8D" Text="Ответственные:"/>
                    <ItemsControl ItemsSource="{Binding ResponsibleUsers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" Margin="15,2,0,0"
                    Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" 
                     Margin="40,30,40,30" HorizontalScrollBarVisibility="Disabled">-->
        <StackPanel  HorizontalAlignment="Stretch" Grid.Column="1" Margin="40,30,40,30">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="RoomTitleText" Style="{StaticResource TitleText}" FontSize="28"
                   FontWeight="Bold" Text="Загрузка..."/>
                        <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                            <TextBlock x:Name="RoomDateText" Style="{StaticResource BodyText}" FontSize="14"
                       Text="Загрузка дат..." Foreground="#7F8C8D"/>
                            <TextBlock x:Name="ParticipantCountText" Style="{StaticResource BodyText}" FontSize="14"
                       Text="Загрузка участников..." Foreground="#7F8C8D" Margin="0,3,0,0"/>
                            <Button Style="{StaticResource TextButton}" 
                                x:Name="LogoutButton"
                                Click="LogoutButton_Click"
                                HorizontalAlignment="Left"
                                Margin="0,3,0,0"
                                Foreground="#E74C3C"
                                Padding="0, 5, 5, 5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Выйти из комнаты"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}"
                            x:Name="InviteUsersButton"
                            Click="InviteUsersButton_Click"
                            ToolTip="Пригласить пользователей"
                            Margin="0,0,10,0">
                            <Image Source="/Images/Icons/user_plus.png" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                            x:Name="RoomSettingsButton"
                            Click="RoomSettingsButton_Click"
                            ToolTip="Настройки комнаты">
                            <Image Source="/Images/Icons/settings.png" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <TabControl x:Name="RoomTabControl" Style="{StaticResource {x:Type TabControl}}" MaxHeight="500" MinHeight="200">
                    <TabItem Header="Маршруты">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#ECF0F1" CornerRadius="8"
                                    BorderBrush="#BDC3C7" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" 
                                               HorizontalAlignment="Right" Margin="10">
                                        <Button Style="{StaticResource TextButton}" 
                                                Click="CreateRouteButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Создать маршрут"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource TextButton}" 
                                                Click="EditRouteButton_Click" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Редактировать"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource WidgetStyle}" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TitleText}" FontSize="16" 
                                                Text="Статистика маршрута"
                                               Margin="0,0,0,15"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" 
                                                       Foreground="#7F8C8D" Text="Цвет маршрута"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Border Width="20" Height="20" Background="#E74C3C" CornerRadius="4"/>
                                                <TextBlock Style="{StaticResource BodyText}" Margin="8,0,0,0" Text="Красный"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" 
                                                       Foreground="#7F8C8D" Text="Длина маршрута"/>
                                            <TextBlock Style="{StaticResource BodyText}"  
                                                       Margin="0,5,0,0" Text="125.5 км"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" 
                                                       Foreground="#7F8C8D" Text="Перепад высот"/>
                                            <TextBlock Style="{StaticResource BodyText}"  
                                                       Margin="0,5,0,0" Text="2,450 м"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" 
                                                       Foreground="#7F8C8D" Text="Точек на маршруте"/>
                                            <TextBlock Style="{StaticResource BodyText}"  
                                                       Margin="0,5,0,0" Text="42"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                <TabItem Header="Снаряжение">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Сообщение -->
                            <RowDefinition Height="*"/>
                            <!-- Список участников с прокруткой -->
                            <RowDefinition Height="Auto"/>
                            <!-- Кнопка сохранения -->
                        </Grid.RowDefinitions>

                        <!-- Сообщение об успехе -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock x:Name="SaveSuccessMessage" 
                       Text="Снаряжение сохранено" 
                       Foreground="Green" 
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       FontWeight="Bold"
                       FontSize="14"/>
                        </StackPanel>

                        <!-- Список участников с внутренней прокруткой -->
                        <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,15">
                            <ItemsControl x:Name="ParticipantsItemsControl" MaxHeight="250" MinHeight="200">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RoomItemStyle}" Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Style="{StaticResource TitleText}" FontSize="16"
                                               Text="{Binding User.Name}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                                   Text="Рост:" Foreground="#7F8C8D"/>
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                                   Text="{Binding User.Height, StringFormat={}{0} см}" Margin="4,0,0,0"/>
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                                   Text="• Вес:" Foreground="#7F8C8D" Margin="8,0,0,0"/>
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                                   Text="{Binding User.Weight, StringFormat={}{0} кг}" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                    <Button Tag="{Binding ParticipantId}"
                                            Click="AddEquipmentButton_Click"
                                            ToolTip="Добавить снаряжение"
                                            Style="{StaticResource MainButton}"
                                            Padding="15,8">
                                                        <TextBlock Text="+ Добавить снаряжение"/>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                    <TextBlock Style="{StaticResource BodyText}"
                                               Text="Снаряжение:" Margin="0,0,0,8"/>
                                                    <StackPanel x:Name="EquipmentStackPanel" 
                                                Tag="{Binding ParticipantId}"
                                                Margin="0,0,0,5">
                                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Foreground="#7F8C8D" 
                                                   Text="Нет добавленного снаряжения"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Background="#F8F9FA" BorderBrush="#E9ECEF"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10" Margin="0,10,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                       Foreground="#7F8C8D" Text="Общий вес"/>
                                                            <TextBlock x:Name="TotalWeightText" 
                                                       Style="{StaticResource BodyText}"
                                                       Text="0 кг" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                       Foreground="#7F8C8D" Text="Количество предметов"/>
                                                            <TextBlock x:Name="TotalItemsText" 
                                                       Style="{StaticResource BodyText}"
                                                       Text="0 шт." Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Кнопка сохранения (ВНЕ прокрутки, всегда видна) -->
                        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
                            <Button Style="{StaticResource MainButton}"
                    x:Name="SaveChangesButton"
                    Click="SaveChangesButton_Click"
                    Padding="28,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Сохранить изменения"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Раскладка">
                    <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="CurrentDayTitle" 
                               Style="{StaticResource TitleText}" 
                               FontSize="20" 
                               Margin="0,0,0,10" 
                               Grid.Row="0"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                                <ItemsControl x:Name="DaysButtonsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                        <Button Style="{StaticResource SidebarButton}"
                                Content="{Binding DayNumber}"
                                Tag="{Binding DayNumber}"
                                Padding="15,8"
                                Margin="0,0,10,0"
                                Click="DayButton_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Прокручиваемый контент дней -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="DaysContentControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,25">
                             <!-- Приёмы пищи -->
                            <ItemsControl ItemsSource="{Binding Meals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RoomItemStyle}" Margin="0,0,0,15">
                                            <StackPanel>
                                                <!-- Заголовок приёма пищи -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Style="{StaticResource TitleText}" FontSize="16"
                                                        Text="{Binding MealName}"/>
                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                        Foreground="#7F8C8D"
                                                        Text="{Binding CaloriesText}"
                                                        Margin="8,2,0,0"/>
                                                </StackPanel>

                                                                    <!-- Рецепт (если есть) -->
                                                <StackPanel Margin="0,0,0,15">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Recipe}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Style="{StaticResource BodyText}"
                                                                   Text="{Binding Recipe.Title}"/>
                                                    </StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                       Foreground="#7F8C8D" Text="Вес на человека"/>
                                                            <TextBlock Style="{StaticResource BodyText}"
                                                                       Text="{Binding WeightPerPersonText}" 
                                                                       Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                       Foreground="#7F8C8D" Text="Время готовки"/>
                                                            <TextBlock Style="{StaticResource BodyText}"
                                                                       Text="{Binding CookTimeText}" 
                                                                       Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- Ингредиенты -->
                                                    <StackPanel Margin="0,0,0,5">
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13" Text="Ингредиенты:"/>
                                                        <ItemsControl ItemsSource="{Binding Recipe.IngredientsRecipes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Style="{StaticResource BodyText}" Margin="15,3,0,0">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding StringFormat="{}{0} {1}г">
                                                                                <Binding Path="Ingredient.Title"/>
                                                                                <Binding Path="Weight"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- Ответственные -->
                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                        Foreground="#7F8C8D" Text="Ответственные:"/>
                                                    <ItemsControl ItemsSource="{Binding ResponsibleUserNames}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Style="{StaticResource BodyText}" Margin="15,2,0,0"
                                                                Text="{Binding}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>

                                                <!-- Сообщение "Нет рецептов" (если нет) -->
                                                <TextBlock Text="Нет добавленных рецептов"
                                                           Foreground="#7F8C8D"
                                                           Margin="0,0,0,15">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Recipe}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Кнопка добавления -->
                                                <Button Style="{StaticResource MainButton}"
                                                        Background="#3498DB"
                                                        Height="40"
                                                        Tag="{Binding Tag}"
                                                        Click="AddRecipeButton_Click">
                                                    <TextBlock Text="Добавить рецепт" 
                                                               HorizontalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Статистика дня -->
                            <Border Style="{StaticResource WidgetStyle}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TitleText}" FontSize="16"
                                        Text="Итоговая статистика дня" 
                                        Margin="0,0,0,15"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                Foreground="#7F8C8D" 
                                                Text="Общая калорийность"/>
                                            <TextBlock Style="{StaticResource BodyText}" 
                                                Text="{Binding TotalDayCaloriesText}" 
                                                Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                Foreground="#7F8C8D" 
                                                Text="Общий вес еды"/>
                                            <TextBlock Style="{StaticResource BodyText}" 
                                                Text="{Binding TotalDayWeightText}" 
                                                Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</TabItem>
                </TabControl>
            </StackPanel>
        <!--</ScrollViewer>-->
    </Grid>
</Page>