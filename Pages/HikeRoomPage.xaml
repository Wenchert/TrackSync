<Page x:Class="TrackSync.Pages.HikeRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TrackSync.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Комната похода"
      Background="#F8F9FA">

    <Page.Resources>
        <DataTemplate x:Key="RecipeTemplate">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Recipe.Title}"/>
                </StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                               Foreground="#7F8C8D" Text="Вес на человека"/>
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding WeightPerPersonText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                               Foreground="#7F8C8D" Text="Время готовки"/>
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding CookTimeText}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,0,0,5">
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Text="Ингредиенты:"/>
                    <ItemsControl ItemsSource="{Binding Ingredients}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" Margin="15,3,0,0"
                                       Text="{Binding Text}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                        Foreground="#7F8C8D" Text="Ответственные:"/>
                    <ItemsControl ItemsSource="{Binding ResponsibleUserNames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="15,2,0,0">
                                    <Ellipse Width="10" Height="10" Fill="#3498DB" 
                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel  HorizontalAlignment="Stretch" Grid.Column="1" Margin="40,30,40,30">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="RoomTitleText" Style="{StaticResource TitleText}" FontSize="28"
                   FontWeight="Bold" Text="Загрузка..."/>
                    <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                        <TextBlock x:Name="RoomDateText" Style="{StaticResource BodyText}" FontSize="14"
                       Text="Загрузка дат..." Foreground="#7F8C8D"/>
                        <TextBlock x:Name="ParticipantCountText" Style="{StaticResource BodyText}" FontSize="14"
                       Text="Загрузка участников..." Foreground="#7F8C8D" Margin="0,3,0,0"/>
                        <Button Style="{StaticResource TextButton}" 
                                x:Name="LogoutButton"
                                Click="LogoutButton_Click"
                                HorizontalAlignment="Left"
                                Margin="0,3,0,0"
                                Foreground="#E74C3C"
                                Padding="0, 5, 5, 5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Выйти из комнаты"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            x:Name="InviteUsersButton"
                            Click="InviteUsersButton_Click"
                            ToolTip="Пригласить пользователей"
                            Margin="0,0,10,0" Height="25">
                        <Image Source="/Images/Icons/user_plus.png" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            x:Name="RoomSettingsButton"
                            Click="RoomSettingsButton_Click"
                            ToolTip="Настройки комнаты"
                            Margin="0,0,10,0" Height="25">
                        <Image Source="/Images/Icons/settings.png" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                        x:Name="DownloadPdfButton"
                        Click="DownloadPdfButton_Click"
                        ToolTip="Скачать статистику (PDF)" Height="25">
                        <Image Source="/Images/Icons/download.png" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>

            <TabControl x:Name="RoomTabControl" Style="{StaticResource {x:Type TabControl}}" MaxHeight="500" MinHeight="200">
                <TabItem Header="Маршруты">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#ECF0F1" CornerRadius="8" BorderBrush="#BDC3C7" BorderThickness="1">
                            <Grid>
                                <!-- Вставляем наш новый контроллер карты -->
                                <local:RouteBuilderControl x:Name="MyRouteBuilder"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                                    <Button x:Name="UndoRouteButton" Content="Отменить действие" Click="UndoRouteButton_Click"  Margin="0,0,10,0" Style="{StaticResource TextButton}"/>
                                    <Button x:Name="SaveRouteButton" Content="Очистить" Click="ClearRoute_Click" Margin="0,0,10,0" Style="{StaticResource MainButton}"/>
                                    <Button x:Name="ClearRouteButton" Content="Сохранить" Click="SaveRoute_Click"  Style="{StaticResource MainButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Ваша панель статистики -->
                        <Border Grid.Row="1" Style="{StaticResource WidgetStyle}" Margin="0,15,0,0">
                            <!-- Используем Grid, чтобы он ограничивал высоту содержимого -->
                            <Grid MaxHeight="250">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <!-- Для сообщений -->
                                    <RowDefinition Height="*"/>
                                    <!-- Для заголовка -->
                                    <RowDefinition Height="*"/>
                                    <!-- Для скролла (занимает все остальное место) -->
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Vertical">
                                    <TextBlock Grid.Row="1" x:Name="MapMessage" Style="{StaticResource BodyText}" 
                                        Foreground="#E74C3C" TextWrapping="Wrap" 
                                        Visibility="Collapsed" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="1" Style="{StaticResource TitleText}" FontSize="16" 
                                        Text="Статистика маршрутов похода" Margin="0,0,0,15"/>
                                </StackPanel>

                                <!-- Теперь ScrollViewer ограничен высотой Grid и будет работать -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" 
                      HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="RoutesStatisticsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Ваш Grid с данными (без изменений) -->
                                                <Grid Margin="0,0,15,10">
                                                    <!-- Добавил отступ справа для бара -->
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Содержимое карточки (Цвет, Автор, Дистанция, Точки) оставляем как было -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                        <TextBlock Text="Цвет" FontSize="11" Foreground="#7F8C8D"/>
                                                        <Border Width="20" Height="20" CornerRadius="4" Margin="0,5,0,0"
                                        Background="{Binding ColorBrush}" HorizontalAlignment="Left"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Создатель" FontSize="11" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding CreatorName}" FontWeight="Bold" Margin="0,5,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Дистанция" FontSize="11" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding DistanceStr}" FontWeight="Bold" Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="Точек" FontSize="11" Foreground="#7F8C8D"/>
                                                        <TextBlock Text="{Binding PointsCount}" FontWeight="Bold" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>


                <TabItem Header="Снаряжение">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Сообщение -->
                            <RowDefinition Height="*"/>
                            <!-- Список участников с прокруткой -->
                            <RowDefinition Height="Auto"/>
                            <!-- Кнопка сохранения -->
                        </Grid.RowDefinitions>

                        <!-- Сообщение об успехе -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock x:Name="SaveSuccessMessage" 
                       Text="Снаряжение сохранено" 
                       Foreground="Green" 
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       FontWeight="Bold"
                       FontSize="14"/>
                        </StackPanel>

                        <!-- Список участников с внутренней прокруткой -->
                        <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Visible" 
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,15" MaxHeight="200">
                            <ItemsControl x:Name="ParticipantsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RoomItemStyle}" Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Style="{StaticResource TitleText}" FontSize="16"
                                               Text="{Binding User.Name}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                                   Text="Рост:" Foreground="#7F8C8D"/>
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                                   Text="{Binding User.Height, StringFormat={}{0} см}" Margin="4,0,0,0"/>
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                                   Text="• Вес:" Foreground="#7F8C8D" Margin="8,0,0,0"/>
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                                   Text="{Binding User.Weight, StringFormat={}{0} кг}" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                    <Button Tag="{Binding ParticipantId}"
                                            Click="AddEquipmentButton_Click"
                                            ToolTip="Добавить снаряжение"
                                            Style="{StaticResource MainButton}"
                                            Padding="15,8">
                                                        <TextBlock Text="+ Добавить снаряжение"/>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                    <TextBlock Style="{StaticResource BodyText}"
                                               Text="Снаряжение:" Margin="0,0,0,8"/>
                                                    <StackPanel x:Name="EquipmentStackPanel" 
                                                Tag="{Binding ParticipantId}"
                                                Margin="0,0,0,5">
                                                        <TextBlock Style="{StaticResource BodyText}"
                                                   Foreground="#7F8C8D" 
                                                   Text="Нет добавленного снаряжения"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Background="#F8F9FA" BorderBrush="#E9ECEF"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10" Margin="0,10,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                       Foreground="#7F8C8D" Text="Общий вес"/>
                                                            <TextBlock x:Name="TotalWeightText" 
                                                       Style="{StaticResource BodyText}"
                                                       Text="0 кг" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                       Foreground="#7F8C8D" Text="Количество предметов"/>
                                                            <TextBlock x:Name="TotalItemsText" 
                                                       Style="{StaticResource BodyText}"
                                                       Text="0 шт." Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Кнопка сохранения -->
                        <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                            <Button Style="{StaticResource MainButton}"
                                    x:Name="SaveChangesButton"
                                    Click="SaveChangesButton_Click"
                                    Padding="28,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Сохранить изменения"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Раскладка">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Vertical">
                            <TextBlock x:Name="CurrentDayTitle" 
                               Style="{StaticResource TitleText}" 
                               FontSize="20" 
                               Margin="0,0,0,10" 
                               Grid.Row="0"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled" 
                              Margin="0,0,0,15">
                                <ItemsControl x:Name="DaysButtonsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarButton}"
                                                Content="{Binding DayNumber}"
                                                Tag="{Binding DayNumber}"
                                                Margin="2"
                                                Click="DayButton_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Прокручиваемый контент дней -->
                        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DaysContentControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,25">
                                            <!-- Приёмы пищи -->
                                            <ItemsControl ItemsSource="{Binding Meals}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource RoomItemStyle}" Margin="0,0,0,15">
                                                            <StackPanel>
                                                                <!-- Заголовок приёма пищи -->
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                                    <TextBlock Style="{StaticResource TitleText}" FontSize="16"
                                                                        Text="{Binding MealName}"/>
                                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                        Foreground="#7F8C8D"
                                                                        Text="{Binding CaloriesText}"
                                                                        Margin="8,2,0,0"/>
                                                                </StackPanel>
                                                                <!-- Раскрывающееся описание: -->
                                                                <StackPanel Margin="0,0,0,10">
                                                                    <!-- Изменение в TabItem "Раскладка" -->
                                                                    <Button x:Name="ToggleDescriptionButton"
                                                                        HorizontalAlignment="Left"
                                                                        Click="ToggleDescriptionButton_Click"
                                                                        Tag="{Binding}"
                                                                        Visibility="{Binding ShowDescriptionButtonVisibility}"
                                                                        Style="{StaticResource TextButton}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="Описание рецепта"/>
                                                                        </StackPanel>
                                                                    </Button>

                                                                    <TextBlock x:Name="DescriptionText"
                                                                       Style="{StaticResource BodyText}"
                                                                       Text="{Binding RecipeDescription}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#7F8C8D"
                                                                       FontSize="13"
                                                                       Margin="15,5,0,0"
                                                                       Visibility="Collapsed"/>
                                                                </StackPanel>

                                                                <!-- Рецепт (если есть) -->
                                                                <StackPanel Margin="0,0,0,15">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Recipe}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                        <TextBlock Style="{StaticResource BodyText}"
                                                                   Text="{Binding Recipe.Title}"/>
                                                                    </StackPanel>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <!-- Первая строка: вес и время готовки -->
                                                                        <Grid Grid.Row="0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Grid.Column="0">
                                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                                    Foreground="#7F8C8D" Text="Вес на человека"/>
                                                                                <TextBlock Style="{StaticResource BodyText}"
                                                                                   Text="{Binding WeightPerPersonText}" 
                                                                                   Margin="0,3,0,0"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1">
                                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                                    Foreground="#7F8C8D" Text="Время готовки"/>
                                                                                <TextBlock Style="{StaticResource BodyText}"
                                                                                   Text="{Binding CookTimeText}" 
                                                                                   Margin="0,3,0,0"/>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <!-- Вторая строка: БЖУ для рецепта -->
                                                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Белки -->
                                                                            <StackPanel Grid.Column="0">
                                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                                                                                    Foreground="#7F8C8D" Text="Белки (на чел)"/>
                                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                                                                                   Text="{Binding ProteinsPerPersonText}" 
                                                                                   Margin="0,2,0,0"/>
                                                                            </StackPanel>

                                                                            <!-- Жиры -->
                                                                            <StackPanel Grid.Column="1">
                                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                                                                                    Foreground="#7F8C8D" Text="Жиры (на чел)"/>
                                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                                                                                   Text="{Binding FatsPerPersonText}" 
                                                                                   Margin="0,2,0,0"/>
                                                                            </StackPanel>

                                                                            <!-- Углеводы -->
                                                                            <StackPanel Grid.Column="2">
                                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                                                                                    Foreground="#7F8C8D" Text="Углеводы (на чел)"/>
                                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                                                                                   Text="{Binding CarbsPerPersonText}" 
                                                                                   Margin="0,2,0,0"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Grid>
                                                                    
                                                                    <!-- Ингредиенты -->
                                                                    <StackPanel Margin="0,0,0,5">
                                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="13" Text="Ингредиенты:"/>
                                                                        <ItemsControl ItemsSource="{Binding IngredientsDisplay}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Style="{StaticResource BodyText}" Margin="15,3,0,0">
                                                                                        <TextBlock.Text>
                                                                                            <MultiBinding StringFormat="{}{0} - {1}г">
                                                                                                <Binding Path="Title"/>
                                                                                                <Binding Path="TotalWeight"/>
                                                                                            </MultiBinding>
                                                                                        </TextBlock.Text>
                                                                                    </TextBlock>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>

                                                                    <!-- Ответственные -->
                                                                    <StackPanel Margin="0,10,0,0">
                                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                        Foreground="#7F8C8D" Text="Ответственные:"/>
                                                                        <ItemsControl ItemsSource="{Binding ResponsibleUserNames}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Style="{StaticResource BodyText}" Margin="15,2,0,0"
                                                                Text="{Binding}"/>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Сообщение "Нет рецептов" (если нет) -->
                                                                <TextBlock Text="Нет добавленных рецептов"
                                                           Foreground="#7F8C8D"
                                                           Margin="0,0,0,15">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Recipe}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <!-- Кнопка добавления -->
                                                                <Button Style="{StaticResource MainButton}"
                                                                    Background="#3498DB"
                                                                    Height="40"
                                                                    Tag="{Binding Tag}"
                                                                    Click="AddRecipeButton_Click">
                                                                    <TextBlock Text="Добавить рецепт" 
                                                               HorizontalAlignment="Center"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Статистика дня -->
                                            <!-- Статистика дня -->
                                            <Border Style="{StaticResource WidgetStyle}" Margin="0,20,0,0">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource TitleText}" FontSize="16"
                   Text="Итоговая статистика дня" 
                   Margin="0,0,0,15"/>

                                                    <!-- Первая строка: калории и вес -->
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                               Foreground="#7F8C8D" 
                                                               Text="Общая калорийность"/>
                                                            <TextBlock Style="{StaticResource BodyText}" 
                                                               Text="{Binding TotalDayCaloriesText}" 
                                                               Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                               Foreground="#7F8C8D" 
                                                               Text="Общий вес еды"/>
                                                            <TextBlock Style="{StaticResource BodyText}" 
                                                               Text="{Binding TotalDayWeightText}" 
                                                               Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Вторая строка: БЖУ -->
                                                    <Border Background="#F8F9FA" Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Белки -->
                                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                   Foreground="#7F8C8D" 
                                                                   Text="Белки"/>
                                                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                                                   Text="{Binding TotalDayProteinsText}" 
                                                                   Margin="0,3,0,0"/>
                                                            </StackPanel>

                                                            <!-- Жиры -->
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                   Foreground="#7F8C8D" 
                                                                   Text="Жиры"/>
                                                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                                                   Text="{Binding TotalDayFatsText}" 
                                                                   Margin="0,3,0,0"/>
                                                            </StackPanel>

                                                            <!-- Углеводы -->
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                   Foreground="#7F8C8D" 
                                                                   Text="Углеводы"/>
                                                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                                                   Text="{Binding TotalDayCarbsText}" 
                                                                   Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Статистика ингредиентов">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Style="{StaticResource TitleText}" FontSize="24" 
                       Text="Статистика ингредиентов" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="14" Foreground="#7F8C8D"
                       Text="Общая стоимость продуктовой раскладки по всем дням похода"/>
                        </StackPanel>

                        <!-- Основной контент с прокруткой -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Общая сводка по стоимости -->
                                <Border Style="{StaticResource WidgetStyle}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
                                   Text="Общая финансовая сводка" Margin="0,0,0,15"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                           Foreground="#7F8C8D" Text="Общая стоимость"/>
                                                <TextBlock x:Name="TotalCostText" Style="{StaticResource TitleText}" 
                                           FontSize="20" Text="0 руб." Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                           Foreground="#7F8C8D" Text="На одного участника"/>
                                                <TextBlock x:Name="CostPerPersonText" Style="{StaticResource TitleText}" 
                                           FontSize="20" Text="0 руб." Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="#F8F9FA" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="#7F8C8D"
                                       TextWrapping="Wrap">
                                            <Run Text="Расчет основан на количестве участников: "/>
                                            <Run x:Name="ParticipantsCountRun" Text="0"/>
                                            <Run Text=" человек"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Детализация по ингредиентам -->
                                <Border Style="{StaticResource WidgetStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
                                   Text="Детализация по ингредиентам" Margin="0,0,0,15"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" FontSize="13"
                                       Foreground="#7F8C8D" Text="Ингредиент"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" FontSize="13"
                                       Foreground="#7F8C8D" Text="Общая стоимость"/>
                                        </Grid>

                                        <Separator Margin="0,5,0,10" Background="#BDC3C7"/>

                                        <!-- Список ингредиентов -->
                                        <ItemsControl x:Name="IngredientsStatisticsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" 
                                            Padding="0,8,0,8" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Style="{StaticResource BodyText}" 
                                                           Text="{Binding IngredientTitle}" FontWeight="SemiBold"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                               Foreground="#7F8C8D" Text="Общий вес: "/>
                                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                               Text="{Binding TotalWeight,  StringFormat={}{0} грамм}"/>
                                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                               Foreground="#7F8C8D" Text=" • Используется в: " Margin="8,0,0,0"/>
                                                                    <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                               Text="{Binding UsedInRecipesCount, StringFormat={}{0} рецепт(ов)}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Style="{StaticResource BodyText}" 
                                                           Text="{Binding TotalCost, StringFormat={}{0} руб.}" 
                                                           FontWeight="SemiBold"/>
                                                                <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                           Foreground="#7F8C8D" Text="{Binding CostPerPerson, StringFormat={}{0} руб./чел}"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Сообщение, если нет данных -->
                                        <TextBlock x:Name="NoIngredientsText" Style="{StaticResource BodyText}" 
                                           Text="Нет данных для отображения. Добавьте рецепты в раскладку."
                                           Foreground="#7F8C8D" HorizontalAlignment="Center"
                                           Margin="0,20,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
</Page>