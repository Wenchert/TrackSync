<Page x:Class="TrackSync.Pages.CatalogIngredientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Каталог ингредиентов"
      Background="#F8F9FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,30,40,30">
        <StackPanel>

            <StackPanel Margin="0,0,0,30">
                <TextBlock Style="{StaticResource TitleText}" FontSize="28" 
                           FontWeight="Bold" Text="Каталог ингредиентов"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="16"
                           Text="Выберите ингредиенты для добавления в рецепт"
                           Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource WidgetStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" 
                            Background="White"
                            BorderBrush="#E9ECEF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" 
                                   Source="/Images/Icons/search.png" 
                                   Width="18" Height="18" 
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" 
                                     x:Name="SearchTextBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="8,0,12,0"
                                     FontSize="14"
                                     Foreground="#2C3E50"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" 
                            Style="{StaticResource MainButton}"
                            Click="CreateIngredientButton_Click"
                            Margin="15,0,0,0"
                            Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+ Создать ингредиент"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border Style="{StaticResource WidgetStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold"
                                       Text="Название ингредиента"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="15,10,10,10"/>

                            <TextBlock Grid.Column="1" 
                                       Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold"
                                       Text="Калории"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,10"/>

                            <TextBlock Grid.Column="2" 
                                       Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold"
                                       Text="Белки"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,10"/>

                            <TextBlock Grid.Column="3" 
                                       Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold"
                                       Text="Жиры"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,10"/>

                            <TextBlock Grid.Column="4" 
                                       Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold"
                                       Text="Углеводы"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,15,10"/>
                        </Grid>

                        <Border Height="2" 
                                Background="#3498DB"
                                Margin="0,5,0,15"/>

                        <ItemsControl x:Name="IngredientsListBox">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="IngredientBorder"
                                            Style="{StaticResource NotificationItemStyle}" 
                                            Margin="0,0,0,8"
                                            Height="50"
                                            MouseLeftButtonDown="IngredientItem_MouseLeftButtonDown"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Style="{StaticResource BodyText}" 
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Text="{Binding Ingredient.Title}"
                                                       Margin="15,0,10,0"/>

                                            <TextBlock Grid.Column="1" 
                                                       Style="{StaticResource BodyText}" 
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Text="{Binding Ingredient.Calories, StringFormat={}{0} ккал}"
                                                       Foreground="#7F8C8D"
                                                       Margin="0"/>

                                            <TextBlock Grid.Column="2" 
                                                       Style="{StaticResource BodyText}" 
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Text="{Binding Ingredient.Proteins, StringFormat={}{0}г}"
                                                       Foreground="#7F8C8D"
                                                       Margin="0"/>

                                            <TextBlock Grid.Column="3" 
                                                       Style="{StaticResource BodyText}" 
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Text="{Binding Ingredient.Fats, StringFormat={}{0}г}"
                                                       Foreground="#7F8C8D"
                                                       Margin="0"/>

                                            <TextBlock Grid.Column="4" 
                                                       Style="{StaticResource BodyText}" 
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Text="{Binding Ingredient.Carbs, StringFormat={}{0}г}"
                                                       Foreground="#7F8C8D"
                                                       Margin="0"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="IngredientBorder" Property="Style" Value="{StaticResource SelectedEquipmentItemStyle}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodyText}" 
                       Foreground="#E74C3C" TextWrapping="Wrap" 
                       Visibility="Collapsed" Margin="0,15,0,0"
                       FontSize="14"/>
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Style="{StaticResource TextButton}" 
                        x:Name="CancelButton"
                        Click="CancelButton_Click"
                        Padding="24,12"
                        Margin="0,0,15,0">
                    <TextBlock Text="Отмена"/>
                </Button>
                <Button Style="{StaticResource MainButton}" 
                        x:Name="AddSelectedButton"
                        Click="AddSelectedButton_Click"
                        Padding="28,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Добавить выбранное"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>