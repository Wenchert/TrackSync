<Page x:Class="TrackSync.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:TrackSync.Controls"  
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync"
      Background="#F8F9FA"
      Loaded="Page_Loaded">

    <StackPanel Margin="40,30,40,30">

        <StackPanel Margin="0,0,0,30">
            <TextBlock x:Name="WelcomeTextBlock" 
                       Style="{StaticResource TitleText}" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Text="Добро пожаловать!"/>
            <TextBlock Style="{StaticResource BodyText}" 
                       FontSize="16"
                       Text="Здесь вы можете управлять своими походами" 
                       Foreground="#7F8C8D"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- УВЕДОМЛЕНИЯ -->
            <Border Grid.Column="0" Style="{StaticResource WidgetStyle}" Margin="0,0,20,0">
                <Grid>
                    <!-- ЗАМЕНИЛ StackPanel на Grid -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Image Source="/Images/Icons/bell.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Style="{StaticResource TitleText}" FontSize="18" FontWeight="Bold" Text="Уведомления"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  MaxHeight="400">
                        <controls:NotificationsPanel x:Name="NotificationsControl" Margin="0,0,0,20" Loaded="NotificationsControl_Loaded"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ПРЕДСТОЯЩИЕ ПОХОДЫ -->
            <Border Grid.Column="1" Style="{StaticResource WidgetStyle}">
                <Grid>
                    <!-- ЗАМЕНИЛ StackPanel на Grid -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Image Source="/Images/Icons/calendar.png" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock Style="{StaticResource TitleText}" FontSize="18" FontWeight="Bold" Text="Предстоящие походы"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  MaxHeight="400">
                        <controls:UpcomingHikesPanel x:Name="UpcomingHikesControl"
                                                  RoomSelected="UpcomingHikesControl_RoomSelected"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</Page>