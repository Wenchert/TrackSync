<Page x:Class="TrackSync.Pages.CreateRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Создание комнаты"
      Background="#F8F9FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,30,40,30">
        <StackPanel MaxWidth="700" HorizontalAlignment="Center">

            <StackPanel Margin="0,0,0,30">
                <TextBlock Style="{StaticResource TitleText}" FontSize="28" 
                           FontWeight="Bold" Text="Создание новой комнаты"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="16"
                           Text="Заполните форму для создания новой комнаты похода"
                           Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource WidgetStyle}">
                <StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Название комнаты" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="TitleTextBox"
                                 MaxLength="256"
                                 Height="40"
                                 TextChanged="TitleTextBox_TextChanged"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Название похода"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Тип комнаты" 
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="PublicRoomRadio" Content="Публичная" 
                                        FontSize="14" Foreground="#2C3E50"
                                        Checked="RoomTypeRadio_Checked"
                                        Margin="0,0,20,0" IsChecked="True"/>
                            <RadioButton x:Name="PrivateRoomRadio" Content="Приватная" 
                                        FontSize="14" Foreground="#2C3E50"
                                        Checked="RoomTypeRadio_Checked" IsChecked="True"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap"
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Text="Публичная - любой пользователь может найти и присоединиться. Приватная - только по приглашению или паролю."/>
                    </StackPanel>

                    <StackPanel x:Name="PasswordPanel" Margin="0,0,0,20" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Пароль для входа" 
                                   Margin="0,0,0,8"/>
                        <PasswordBox Style="{StaticResource PasswordField}" 
                                     x:Name="PasswordBox"
                                     Height="40"
                                     MaxLength="256"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Пароль необходим для присоединения к приватной комнате (минимум 8 символов)"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Описание похода" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="DescriptionTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"
                                 MaxHeight="300"
                                 TextChanged="DescriptionTextBox_TextChanged"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Напишите дополнительную информацию о походе"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Даты похода" 
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Text="Начало похода" 
                                           Margin="0,0,0,5"
                                           FontSize="13"/>
                                <DatePicker x:Name="StartDatePicker" 
                                           Style="{StaticResource DatePickerStyle}"
                                           SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource BodyText}" 
                                           Text="Окончание похода" 
                                           Margin="0,0,0,5"
                                           FontSize="13"/>
                                <DatePicker x:Name="EndDatePicker" 
                                           Style="{StaticResource DatePickerStyle}"
                                           SelectedDateChanged="EndDatePicker_SelectedDateChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Text="Укажите период проведения похода"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodyText}" 
                               Foreground="#E74C3C" TextWrapping="Wrap" 
                               Visibility="Collapsed" Margin="0,0,0,15"
                               FontSize="14"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TextButton}" 
                                x:Name="CancelButton"
                                Click="CancelButton_Click"
                                Margin="0,0,15,0">
                            <TextBlock Text="Отмена"/>
                        </Button>
                        <Button Style="{StaticResource MainButton}" 
                                x:Name="CreateButton"
                                Click="CreateRoomButton_Click"
                                Padding="28,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE105;" 
                                          Margin="0,0,8,0"/>
                                <TextBlock Text="Создать комнату"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>