<Page x:Class="TrackSync.Pages.LayoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrackSync.Pages"
      mc:Ignorable="d" 
d:DesignHeight="700" d:DesignWidth="1200"
      Background="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Height="60" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="SidebarToggleBtn" Style="{StaticResource IconButton}"
                            Click="SidebarToggleBtn_Click" Margin="0,0,15,0">
                        <Image Source="/Images/Icons/menu.png" Width="20" Height="20"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="22" 
                                   FontWeight="Bold" Text="Track" 
                                   Foreground="#3498DB"/>
                        <TextBlock Style="{StaticResource TitleText}" FontSize="22" 
                                   FontWeight="Bold" Text="Sync" 
                                   Foreground="#1B4F72"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                           Margin="0,0,20,0" VerticalAlignment="Center">
                    <Button x:Name="NotificationsBtn" Style="{StaticResource IconButton}"
                            Click="NotificationsBtn_Click" ToolTip="Уведомления">
                        <Grid>
                            <Image Source="/Images/Icons/bell.png" Width="22" Height="22"/>
                            <Border x:Name="NotificationBadge" Style="{StaticResource NotificationBadgeStyle}"
                                    Visibility="Collapsed" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-6,0">
                                <TextBlock x:Name="NotificationCount" Text="0" Foreground="White" 
                                           FontSize="10" HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="ProfileBtn" Style="{StaticResource IconButton}"
                            Click="ProfileBtn_Click" Margin="15,0,0,0" ToolTip="Профиль">
                        <Image Source="/Images/Icons/user.png" Width="22" Height="22"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="White" 
                    Width="320" HorizontalAlignment="Left"
                    BorderBrush="#E9ECEF" BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8F9FA" Padding="15" 
                            BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
                        <TextBox x:Name="RoomSearchBox" Style="{StaticResource InputField}"
                                 TextChanged="RoomSearchBox_TextChanged"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,15,0,20">
                            <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
                                       FontWeight="Bold" Margin="20,0,0,15"
                                       Text="Меню приложения"/>

                            <StackPanel Margin="0,0,0,20">
                                <Button Style="{StaticResource SidebarButton}" 
                                        Click="CreateRoomMenuBtn_Click" Height="45">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Images/Icons/add.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="Создать комнату" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" 
                                        Click="RecipesCatalogBtn_Click" Height="45" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Images/Icons/food.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="Каталог рецептов" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" 
                                        Click="EquipmentCatalogBtn_Click" Height="45" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Images/Icons/backpack.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="Каталог снаряжения" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Height="1" Background="#E9ECEF" Margin="20,15,20,15"/>

                            <TextBlock Text="Ваши комнаты" Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold" Margin="20,0,20,15"/>

                            <StackPanel x:Name="RoomsListPanel">
                                <Border Style="{StaticResource RoomItemStyle}" 
                                        Tag="1" MouseLeftButtonDown="RoomItem_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Style="{StaticResource TitleText}" FontSize="15"
                                                   Text="Поход на Эльбрус"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource BodyText}"
                                                   Text="15-25 июля 2025" Foreground="#7F8C8D"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Border Background="#2ECC71" CornerRadius="4" Padding="4,1">
                                                <TextBlock Text="Активный" Foreground="White" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="5 участников" Style="{StaticResource BodyText}" 
                                                       Foreground="#7F8C8D" Margin="5,0,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" 
                                                VerticalAlignment="Center">
                                            <Image Source="/Images/Icons/arrow-right.png" Width="18" Height="18"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource RoomItemStyle}" 
                                        Tag="2" MouseLeftButtonDown="RoomItem_MouseLeftButtonDown" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Style="{StaticResource TitleText}" FontSize="15"
                                                   Text="Треккинг в Карелии"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource BodyText}"
                                                   Text="5-15 августа 2025" Foreground="#7F8C8D"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Border Background="#3498DB" CornerRadius="4" Padding="4,1">
                                                <TextBlock Text="Планирование" Foreground="White" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="3 участника" Style="{StaticResource BodyText}" 
                                                       Foreground="#7F8C8D" Margin="5,0,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" 
                                                VerticalAlignment="Center">
                                            <Image Source="/Images/Icons/arrow-right.png" Width="18" Height="18"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ContentPresenter Grid.Column="1" x:Name="PageContent"/>
        </Grid>

        <Border Grid.Row="2" Background="White" Height="50" 
                BorderBrush="#E9ECEF" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                       VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyText}" Text="© 2025 TrackSync" 
                          Foreground="#7F8C8D" Margin="0,0,20,0"/>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Click="VkBtn_Click"
                           ToolTip="ВКонтакте">
                        <Image Source="/Images/Icons/vk.png" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="TelegramBtn_Click"
                           Margin="15,0,0,0" ToolTip="Telegram">
                        <Image Source="/Images/Icons/telegram.png" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
