<Page x:Class="TrackSync.Pages.CreateRecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Создание рецепта"
      Background="#F8F9FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,30,40,30">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center">

            <StackPanel Margin="0,0,0,30">
                <TextBlock Style="{StaticResource TitleText}" FontSize="28" 
                           FontWeight="Bold" Text="Создание рецепта"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="16"
                           Text="Добавьте новый рецепт в ваш каталог для использования в походах"
                           Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource WidgetStyle}">
                <StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Название рецепта" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="TitleTextBox"
                                 MaxLength="256"
                                 Height="40"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Введите название рецепта"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Время готовки (минуты)" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="TimeTextBox"
                                 Height="40"/>
                        <TextBlock Style="{StaticResource BodyText}" 
                                   Foreground="#7F8C8D" 
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Text="Укажите время приготовления в минутах (только целое число)"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold" 
                                   Text="Описание / Способ приготовления" 
                                   Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource InputField}" 
                                 x:Name="DescriptionTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"
                                 MaxHeight="300"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Style="{StaticResource TitleText}" 
                                   FontSize="18" FontWeight="Bold"
                                   Text="Ингредиенты"/>
                        <Button Style="{StaticResource MainButton}" 
                                Margin="15,0,0,0"
                                Padding="16,8"
                                Click="SelectFromCatalogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Выбрать из каталога" 
                                           FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Background="#F8F9FA" 
                            BorderBrush="#E9ECEF" 
                            BorderThickness="1" 
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <StackPanel x:Name="IngredientsStackPanel">

                                <TextBlock x:Name="EmptyIngredientsText" 
                                           Style="{StaticResource BodyText}"
                                           Text="Список ингредиентов пуст. Нажмите 'Выбрать из каталога', чтобы добавить ингредиенты."
                                           Foreground="#95A5A6"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodyText}" 
                               Foreground="#E74C3C" TextWrapping="Wrap" 
                               Visibility="Collapsed" Margin="0,0,0,15"
                               FontSize="14"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TextButton}" 
                                x:Name="CancelButton"
                                Margin="0,0,15,0"
                                Click="CancelButton_Click">
                            <TextBlock Text="Отмена"/>
                        </Button>
                        <Button Style="{StaticResource MainButton}" 
                                x:Name="CreateButton"
                                Padding="28,12"
                                Click="CreateButton_Click">
                            <TextBlock>
                                <TextBlock Text="Создать рецепт"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>