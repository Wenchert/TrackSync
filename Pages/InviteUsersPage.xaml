<Page x:Class="TrackSync.Pages.InviteUsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="TrackSync - Приглашение пользователей"
      Background="#F8F9FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="40,30,40,30">
        <StackPanel>
            <!-- Заголовок страницы -->
            <StackPanel Margin="0,0,0,30">
                <TextBlock Style="{StaticResource TitleText}" FontSize="28" 
                           FontWeight="Bold" Text="Приглашение пользователей"/>
                <TextBlock Style="{StaticResource BodyText}" FontSize="16"
                           Text="Выберите пользователей для приглашения в комнату"
                           Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Панель поиска -->
            <Border Style="{StaticResource WidgetStyle}" Margin="0,0,0,20">
                <Border Background="White"
                        BorderBrush="#E9ECEF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" 
                               Source="/Images/Icons/search.png" 
                               Width="18" Height="18" 
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1" 
                                 x:Name="SearchTextBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="8,0,12,0"
                                 FontSize="14"
                                 Foreground="#2C3E50"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged"/>
                    </Grid>
                </Border>
            </Border>

            <!-- Список пользователей -->
            <Border Style="{StaticResource WidgetStyle}">
                <StackPanel>
                    <!-- Заголовок таблицы -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1" 
                                   Style="{StaticResource BodyText}" 
                                   FontWeight="SemiBold"
                                   Text="Email пользователя"/>
                    </Grid>

                    <!-- Разделитель -->
                    <Border Height="1" 
                            Background="#E9ECEF" 
                            Margin="0,0,0,15"/>

                    <!-- Список пользователей (10 примеров) -->
                    <StackPanel x:Name="UsersListPanel">
                        <!-- Пользователь 1 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck1"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="ivanov@example.com"/>
                            </Grid>
                        </Border>

                        <!-- Пользователь 2 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck2"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="petrov@example.com"/>
                            </Grid>
                        </Border>

                        <!-- Пользователь 3 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck3"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="sidorov@example.com"/>
                            </Grid>
                        </Border>

                        <!-- Пользователь 4 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck4"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="smirnova@example.com"/>
                            </Grid>
                        </Border>

                        <!-- Пользователь 5 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck5"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="kuznetsov@example.com"/>
                            </Grid>
                        </Border>

                        <!-- Пользователь 6 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck6"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="vasiliev@example.com"/>
                            </Grid>
                        </Border>

                        <!-- Пользователь 7 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck7"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="novikov@example.com"/>
                            </Grid>
                        </Border>

                        <!-- Пользователь 8 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck8"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="mikhailov@example.com"/>
                            </Grid>
                        </Border>

                        <!-- Пользователь 9 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck9"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="fedorov@example.com"/>
                            </Grid>
                        </Border>

                        <!-- Пользователь 10 -->
                        <Border Style="{StaticResource NotificationItemStyle}" 
                                Margin="0,0,0,10"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          x:Name="UserCheck10"/>

                                <TextBlock Grid.Column="1" 
                                           Style="{StaticResource BodyText}" 
                                           VerticalAlignment="Center"
                                           Text="morozov@example.com"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Панель пагинации -->
            <Border Style="{StaticResource WidgetStyle}" 
                    Margin="0,20,0,0"
                    Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" 
                               FontWeight="SemiBold"
                               Text="Выбрано: 0 пользователей"
                               x:Name="SelectedCountText"
                               Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <Button Style="{StaticResource TextButton}"
                                Content="← Предыдущая"
                                Width="120"
                                Height="36"/>

                        <Button Style="{StaticResource TextButton}"
                                Content="1"
                                Width="40"
                                Height="36"
                                Background="#3498DB"
                                Foreground="White"/>

                        <Button Style="{StaticResource TextButton}"
                                Content="2"
                                Width="40"
                                Height="36"/>

                        <Button Style="{StaticResource TextButton}"
                                Content="3"
                                Width="40"
                                Height="36"/>

                        <Button Style="{StaticResource TextButton}"
                                Content="4"
                                Width="40"
                                Height="36"/>

                        <Button Style="{StaticResource TextButton}"
                                Content="5"
                                Width="40"
                                Height="36"/>

                        <Button Style="{StaticResource TextButton}"
                                Content="Следующая →"
                                Width="120"
                                Height="36"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Кнопки действий -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Style="{StaticResource TextButton}" 
                        x:Name="CancelButton"
                        Click="CancelButton_Click"
                        Padding="24,12"
                        Margin="0,0,15,0">
                    <TextBlock Text="Отмена"/>
                </Button>
                <Button Style="{StaticResource MainButton}" 
                        x:Name="AddUsersButton"
                        Click="AddUsersButton_Click"
                        Padding="28,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Добавить пользователей"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>