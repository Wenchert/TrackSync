<Window x:Class="TrackSync.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:TrackSync.Pages"
        mc:Ignorable="d"
        Title="TrackSync" Height="700" Width="1200"
        Icon="/Images/Icons/favicon.png"
        Background="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="AppHeader" Grid.Row="0" Background="White" Height="60" 
                BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="SidebarToggleBtn" Style="{StaticResource IconButton}"
                            Click="SidebarToggleBtn_Click" Margin="0,0,15,0">
                        <Image Source="/Images/Icons/menu.png" Width="20" Height="20"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="22" 
                                   FontWeight="Bold" Text="Track" 
                                   Foreground="#3498DB"/>
                        <TextBlock Style="{StaticResource TitleText}" FontSize="22" 
                                   FontWeight="Bold" Text="Sync" 
                                   Foreground="#1B4F72"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                           Margin="0,0,20,0" VerticalAlignment="Center">
                    <Button x:Name="NotificationsBtn" Style="{StaticResource IconButton}"
                            Click="NotificationsBtn_Click" ToolTip="Уведомления">
                        <Grid>
                            <Image Source="/Images/Icons/bell.png" Width="22" Height="22"/>
                            <Border x:Name="NotificationBadge" Style="{StaticResource NotificationBadgeStyle}"
                                    Visibility="Collapsed" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-6,0">
                                <TextBlock x:Name="NotificationCount" Text="0" Foreground="White" 
                                           FontSize="10" HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="ProfileBtn" Style="{StaticResource IconButton}"
                            Click="ProfileBtn_Click" Margin="15,0,0,0" ToolTip="Профиль">
                        <Image Source="/Images/Icons/user.png" Width="22" Height="22"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="White" 
                    Width="320" HorizontalAlignment="Left"
                    BorderBrush="#E9ECEF" BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" 
                            Background="White"
                            BorderBrush="#E9ECEF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="40"
                            Margin="20,15,20,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" 
                                   Source="/Images/Icons/search.png" 
                                   Width="18" Height="18" 
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" 
                                     x:Name="SearchTextBox"
                                     BorderThickness="0"
                                     Background="#F8F9FA"
                                     Padding="8,0,12,0"
                                     FontSize="14"
                                     Foreground="#2C3E50"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource TitleText}" FontSize="18" 
                                       FontWeight="Bold" Margin="20,0,0,15"
                                       Text="Меню приложения"/>

                            <StackPanel Margin="0,0,0,20">
                                <Button Style="{StaticResource SidebarButton}" 
                                        Click="CreateRoomMenuBtn_Click" Height="45">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+ Создать комнату" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" 
                                        Click="RecipesCatalogBtn_Click" Height="45" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Images/Icons/food.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="Каталог рецептов" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" 
                                        Click="EquipmentCatalogBtn_Click" Height="45" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Images/Icons/backpack.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="Каталог снаряжения" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Height="1" Background="#E9ECEF" Margin="20,15,20,15"/>

                            <TextBlock Text="Ваши комнаты" Style="{StaticResource BodyText}" 
                                       FontWeight="SemiBold" Margin="20,0,20,15"/>
                            <ListBox x:Name="SidebarRoomsListBox" 
                                     BorderThickness="0" 
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RoomItemStyle}" 
                                                Tag="{Binding HikeRoomId}" 
                                                Cursor="Hand"
                                                MouseLeftButtonDown="SidebarRoomItem_MouseLeftButtonDown"
                                                Margin="0,0,0,10"
                                                Padding="15">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Style="{StaticResource TitleText}" FontSize="15"
                                                           Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Orientation="Horizontal" Grid.Row="1">
                                                    <TextBlock Style="{StaticResource BodyText}"
                                                           Text="{Binding StartDate, StringFormat={}{0:dd MMM yyyy}}"
                                                           Foreground="#7F8C8D" FontSize="13"/>
                                                    <TextBlock Style="{StaticResource BodyText}"
                                                           Text=" - "
                                                           Foreground="#7F8C8D" FontSize="13"/>
                                                    <TextBlock Style="{StaticResource BodyText}"
                                                           Text="{Binding EndDate, StringFormat={}{0:dd MMM yyyy}}"
                                                           Foreground="#7F8C8D" FontSize="13"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border CornerRadius="4" Padding="4,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#95A5A6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status.StatusId}" Value="1">
                                                                        <Setter Property="Background" Value="#3498DB"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status.StatusId}" Value="2">
                                                                        <Setter Property="Background" Value="#2ECC71"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status.StatusId}" Value="3">
                                                                        <Setter Property="Background" Value="#95A5A6"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status.StatusId}" Value="4">
                                                                        <Setter Property="Background" Value="#E74C3C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status.Title}" Foreground="White" FontSize="10"/>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Participants.Count}" 
                                                               Style="{StaticResource BodyText}" Foreground="#7F8C8D" Margin="8,0,0,0" FontSize="13"/>
                                                        <TextBlock Text="участников" 
                                                               Style="{StaticResource BodyText}" Foreground="#7F8C8D" Margin="8,0,0,0" FontSize="13"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Frame x:Name="mainWindow" Grid.Column="1" NavigationUIVisibility="Hidden"/>
        </Grid>
        <Border x:Name="AppFooter" Grid.Row="2" Background="White" Height="50" 
                BorderBrush="#E9ECEF" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                       VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyText}" Text="© 2025 TrackSync" 
                          Foreground="#7F8C8D" Margin="0,0,20,0"/>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Click="VkBtn_Click"
                           ToolTip="ВКонтакте">
                        <Image Source="/Images/Icons/vk.png" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="TelegramBtn_Click"
                           Margin="15,0,0,0" ToolTip="Telegram">
                        <Image Source="/Images/Icons/telegram.png" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>